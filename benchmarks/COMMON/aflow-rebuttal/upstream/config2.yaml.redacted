models:
  "gemini-2.5-flash-lite":
    api_type: "openai"
    base_url: "https://generativelanguage.googleapis.com/v1beta/openai/"
    api_key: "<YOUR_KEY>"
    temperature: 0
    # Executor only. Bounds a runaway generation; one MuSR reply reached
    # 311,957 characters. Deliberately not set on the optimizer, whose
    # thinking tokens count against the same budget.
    max_tokens: 4096
  "gemini-3.1-pro-preview":
    api_type: "openai"
    base_url: "https://generativelanguage.googleapis.com/v1beta/openai/"
    api_key: "<YOUR_KEY>"
    temperature: 0
  "openai/gpt-oss-120b":            
    api_type: "openai"
    base_url: "https://openrouter.ai/api/v1"
    api_key: "<YOUR_KEY>"
    temperature: 0

  "deepseek/deepseek-chat-v3.1":
    api_type: "openai"
    base_url: "https://openrouter.ai/api/v1"
    api_key: "<YOUR_KEY>"
    temperature: 0
    # Executor for the Table 2/3 runs. Same cap and reasoning as Flash-Lite.
    max_tokens: 4096
    # OpenRouter routes this model to whichever host is cheapest unless told
    # otherwise, and its default, DeepInfra, serves it at fp4. The Table 2/3
    # baselines ran on Together's fp8 serving, so an fp4 executor would put a
    # more compressed model in the column it is compared against. SiliconFlow
    # is fp8 and carries the largest context of the fp8 hosts (163,840), which
    # the long RuleArena NBA prompts need. Fallbacks are off so a throttle
    # fails loudly instead of quietly rerouting to a different quantization
    # partway through a run.
    extra_body:
      provider:
        # All three serve this model at fp8, which is the property that has to
        # match the Table 2/3 columns. Pinning one host throttled: a single
        # search measured slower at concurrency 25 than at 10, so concurrent
        # searches share one host's ceiling. Allowing the fp8 set lifts that
        # without letting OpenRouter fall back to its fp4 default. Every
        # recorded call names the host that served it, so cost stays exact.
        only: ["SiliconFlow", "Novita", "AtlasCloud"]
        allow_fallbacks: false
  "deepseek-v31-novita":
    api_type: "openai"
    # The same model as above, pinned to one host. OpenRouter prefers an `only`
    # list in order, so a multi-host list all lands on the first host and one
    # provider's ceiling caps every search. One entry per host lets searches be
    # spread across the fp8 hosts deliberately.
    model: "deepseek/deepseek-chat-v3.1"
    base_url: "https://openrouter.ai/api/v1"
    api_key: "<YOUR_KEY>"
    temperature: 0
    max_tokens: 4096
    extra_body:
      provider:
        only: ["Novita"]
        allow_fallbacks: false
  "deepseek-v31-atlascloud":
    api_type: "openai"
    # The same model as above, pinned to one host. OpenRouter prefers an `only`
    # list in order, so a multi-host list all lands on the first host and one
    # provider's ceiling caps every search. One entry per host lets searches be
    # spread across the fp8 hosts deliberately.
    model: "deepseek/deepseek-chat-v3.1"
    base_url: "https://openrouter.ai/api/v1"
    api_key: "<YOUR_KEY>"
    temperature: 0
    max_tokens: 4096
    extra_body:
      provider:
        only: ["AtlasCloud"]
        allow_fallbacks: false
